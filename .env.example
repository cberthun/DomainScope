# DomainScope - Konfiguration (nach .env kopieren; .env niemals committen)
APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin
# Zufälliger Schlüssel (php bin/setup.php erzeugt ihn)
APP_KEY=

# Zugang (Einzelnutzer). Passwort-Hash erzeugen: php bin/setup.php
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Optional: kommagetrennte IP-Allowlist (leer = keine Einschränkung)
AUTH_IP_ALLOWLIST=
SESSION_IDLE_TIMEOUT=3600
# Auf 1 setzen, wenn die Anwendung hinter HTTPS läuft (Secure-Cookie, HSTS)
FORCE_HTTPS=0
# Vertrauenswürdiger Reverse Proxy (IP), dessen X-Forwarded-For berücksichtigt wird
TRUSTED_PROXY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=domainscope
DB_USER=domainscope
DB_PASS=
DB_CHARSET=utf8mb4

# Optional: Kontaktadresse/URL, die im User-Agent ausgehender Anfragen steht (hilfreich für Betreiber von crt.sh & Co.)
HTTP_CONTACT=
